NEXT_PUBLIC_API_URL=http://localhost:5000/api
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
MONGODB_URI=
DB_NAME=equipra
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
JWT_SECRET=
JWT_ISSUER=equipra-web
JWT_AUDIENCE=equipra-api
NEXT_PUBLIC_IMGBB_KEY=
# mock = in-memory demo data, api = the Express server at NEXT_PUBLIC_API_URL
NEXT_PUBLIC_DATA_SOURCE=mock
# Seed only (scripts/seed.mjs) — demo test credentials, never real secrets.
# Run with: npm run seed -- --db equipra_dev   (or --db equipra)
# Demo accounts created by the seed:
#   admin@equipra.app               (admin)    password: SEED_ADMIN_PASSWORD
#   mahfuz@riverbank-plant.test    (owner)    password: SEED_USER_PASSWORD
#   tanisha@framecraft-studio.test  (owner)    password: SEED_USER_PASSWORD
#   nabil@equipra-demo.test         (customer) password: SEED_USER_PASSWORD
#   siam@equipra-demo.test          (customer) password: SEED_USER_PASSWORD
SEED_ADMIN_PASSWORD=
SEED_USER_PASSWORD=
